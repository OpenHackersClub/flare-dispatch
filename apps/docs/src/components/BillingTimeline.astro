---
// Billing-model graphic for the landing page.
//
// Thesis: an agentic code-review run is dominated by LLM I/O — the model
// thinking while the vCPU sits idle. GitHub Actions bills per wall-clock
// minute, so you pay for that idle wait. FlareDispatch runs on Cloudflare
// Containers, billed per vCPU-second, so the wait scales toward zero and you
// pay only for the active slivers.
//
// One run, three bars stacked on a shared time axis:
//   1. the run itself — vCPU-active vs LLM-wait segments
//   2. GitHub Actions  — the whole width is billed
//   3. FlareDispatch   — only the vCPU-active columns are billed
//
// Segment widths are illustrative but proportionate: ~20% active, ~80% wait.

type Seg = { kind: "cpu" | "io"; w: number; label?: string };

const segments: Seg[] = [
  { kind: "cpu", w: 4, label: "clone + setup" },
  { kind: "io", w: 17, label: "LLM · read the diff" },
  { kind: "cpu", w: 3 },
  { kind: "io", w: 22, label: "LLM · review batch 1" },
  { kind: "cpu", w: 2 },
  { kind: "io", w: 21, label: "LLM · review batch 2" },
  { kind: "cpu", w: 2 },
  { kind: "io", w: 20, label: "LLM · synthesize findings" },
  { kind: "cpu", w: 9, label: "post check-run" },
];

const total = segments.reduce((s, x) => s + x.w, 0);
const cpuPct = segments
  .filter((s) => s.kind === "cpu")
  .reduce((s, x) => s + x.w, 0);

const X0 = 8;
const X1 = 712;
const W = X1 - X0;

let cursor = X0;
const placed = segments.map((s) => {
  const x = cursor;
  const w = (s.w / total) * W;
  cursor += w;
  return { ...s, x, w };
});

const TRACK_Y = 64;
const GHA_Y = 176;
const FD_Y = 254;
const BAR_H = 30;
const BAND_TOP = TRACK_Y;
const BAND_BOTTOM = FD_Y + BAR_H;
---

<figure class="billing" aria-labelledby="billing-caption">
  <svg
    class="billing__svg"
    viewBox="0 0 720 350"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`A code-review run is roughly ${cpuPct} percent vCPU-active work and ${total - cpuPct} percent LLM I/O wait. GitHub Actions bills the whole run by wall-clock minute; FlareDispatch bills only the vCPU-active fraction.`}
  >
    <defs>
      <pattern
        id="bd-wait"
        width="7"
        height="7"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
      >
        <rect class="bg" width="7" height="7" />
        <line class="hatch" x1="0" y1="0" x2="0" y2="7" />
      </pattern>
    </defs>

    <!-- vCPU-active columns carried down through all three bars -->
    {placed
      .filter((s) => s.kind === "cpu")
      .map((s) => (
        <rect
          class="col-active"
          x={s.x}
          y={BAND_TOP}
          width={s.w}
          height={BAND_BOTTOM - BAND_TOP}
        />
      ))}

    <!-- Row 1: the run -->
    <text class="row-label" x={X0} y={36}>A CODE-REVIEW RUN, OVER WALL-CLOCK TIME</text>
    {placed.map((s) =>
      s.kind === "io" && s.label ? (
        <text class="phase" x={s.x + s.w / 2} y={TRACK_Y - 8} text-anchor="middle">
          {s.label}
        </text>
      ) : null,
    )}
    {placed.map((s) => (
      <rect
        class={s.kind === "cpu" ? "track-cpu" : "track-io"}
        x={s.x}
        y={TRACK_Y}
        width={s.w}
        height={BAR_H}
      />
    ))}
    {placed.map((s) =>
      s.kind === "cpu" && s.label ? (
        <text class="phase phase--cpu" x={s.x + s.w / 2} y={TRACK_Y + BAR_H + 13} text-anchor="middle">
          {s.label}
        </text>
      ) : null,
    )}
    <text class="axis" x={X0} y={138}>wall-clock time →</text>

    <!-- Row 2: GitHub Actions — bills everything -->
    <text class="row-label" x={X0} y={GHA_Y - 12}>
      GITHUB ACTIONS — billed per wall-clock minute
    </text>
    <rect class="bill-all" x={X0} y={GHA_Y} width={W} height={BAR_H} />
    <text class="bill-note bill-note--all" x={X0 + W / 2} y={GHA_Y + BAR_H / 2 + 3} text-anchor="middle">
      every second billed — the idle LLM wait included
    </text>

    <!-- Row 3: FlareDispatch — bills only the active slivers -->
    <text class="row-label" x={X0} y={FD_Y - 12}>
      FLAREDISPATCH — billed per vCPU-second
    </text>
    <rect class="bill-envelope" x={X0} y={FD_Y} width={W} height={BAR_H} />
    {placed
      .filter((s) => s.kind === "cpu")
      .map((s) => (
        <rect class="bill-active" x={s.x} y={FD_Y} width={s.w} height={BAR_H} />
      ))}
    {placed
      .filter((s) => s.kind === "io" && s.w > 90)
      .map((s) => (
        <text class="bill-idle" x={s.x + s.w / 2} y={FD_Y + BAR_H / 2 + 3} text-anchor="middle">
          not billed
        </text>
      ))}

    <!-- Legend -->
    <g class="legend" transform={`translate(${X0}, 322)`}>
      <rect class="legend-swatch track-cpu" x="0" y="-9" width="12" height="12" />
      <text class="legend-label" x="18" y="1">vCPU-active</text>
      <rect class="legend-swatch track-io" x="118" y="-9" width="12" height="12" />
      <text class="legend-label" x="136" y="1">LLM I/O wait</text>
    </g>
  </svg>
  <figcaption id="billing-caption" class="sr-only">
    Roughly {cpuPct}% of an agentic code-review run is vCPU-active; the
    remaining {total - cpuPct}% is the model thinking — idle I/O wait. GitHub
    Actions bills the entire wall-clock run; FlareDispatch bills only the
    vCPU-active fraction.
  </figcaption>
</figure>
