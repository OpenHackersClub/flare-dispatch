---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../lib/site";

const path = Astro.url.pathname;
const isDocs = path.startsWith("/docs");
const isRecipes = path.startsWith("/recipes");
const isBenchmarks = path.startsWith("/benchmarks");
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="FlareDispatch home">
      <svg class="site-header__brand-mark" aria-hidden="true" viewBox="0 0 32 32">
        <path d="M8 30 C11 24 15 21 20 18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        <path d="M21 2 L23 10 L21 18 L19 10 Z M13 10 L21 8 L29 10 L21 12 Z" fill="currentColor"/>
      </svg>
      FlareDispatch<em>v0 · spec</em>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>Index</a>
      <a href="/docs" aria-current={isDocs ? "page" : undefined}>Specs</a>
      <a href="/recipes" aria-current={isRecipes ? "page" : undefined}>Recipes</a>
      <a href="/benchmarks" aria-current={isBenchmarks ? "page" : undefined}>Benchmarks</a>
      <a href={site.repo} target="_blank" rel="noreferrer noopener">Repo ↗</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
