---
import { recipes } from "../lib/recipes";

interface Props {
  currentSlug?: string;
}
const { currentSlug } = Astro.props;

// Grouped by what fires the run, not by a single mode — so every recipe
// appears (the old Action/Webhook split dropped the wall-clock family).
const groups = [
  { kind: "github-event" as const, number: "01", title: "Event-driven" },
  { kind: "wall-clock" as const, number: "02", title: "Wall-clock" },
];
---

<aside class="docs-shell__sidebar" aria-label="Recipe sections">
  {
    groups.map((group) => (
      <div class="sidebar-section">
        <div class="sidebar-section__header">
          <span class="sidebar-section__num">§{group.number}</span>
          <span class="sidebar-section__title">{group.title}</span>
        </div>
        <ul class="sidebar-section__list">
          {recipes
            .filter((r) => r.triggerKind === group.kind)
            .map((r) => (
              <li>
                <a
                  href={`/recipes/${r.slug}`}
                  aria-current={currentSlug === r.slug ? "page" : undefined}
                >
                  {r.label}
                </a>
              </li>
            ))}
        </ul>
      </div>
    ))
  }
</aside>
