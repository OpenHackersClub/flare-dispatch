---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDiagram from "../components/HeroDiagram.astro";
import { site } from "../lib/site";
import githubActionsSrc from "../snippets/github-actions.txt?raw";
import offloadTestSrc from "../snippets/offload-test.txt?raw";
import deploySmokeSrc from "../snippets/deploy-smoke.txt?raw";
import prReviewSrc from "../snippets/pr-review.txt?raw";

const value = [
  {
    id: "01 / Cost",
    title: "Pay per vCPU-second",
    body: "Heavy compute is billed at Cloudflare Container rates — per vCPU-second, scale-to-zero between runs — instead of GitHub Actions per-minute. The jobs that dominate your CI bill move to the cheapest place to run them.",
  },
  {
    id: "02 / Headroom",
    title: "No platform ceilings",
    body: "No 6-hour job limit. No 10 GB cache cap. Artifact retention you set, not a fixed 90 days. The limits that push teams onto self-hosted runners simply aren't there.",
  },
  {
    id: "03 / Fit",
    title: "Drops into your setup",
    body: "GitHub Actions stays the trigger and the PR gate. One wrangler deploy into the Cloudflare account you already pay for. Results land as a GitHub Check Run — no new dashboard, no runner fleet to operate.",
  },
];

const runs = [
  {
    id: "RUN 01",
    title: "offload-test",
    body: "Run any test command — pnpm test, pytest, cargo test — in a CF Sandbox. The V0 walking skeleton: green/red back to a PR check.",
  },
  {
    id: "RUN 02",
    title: "matrix-fanout",
    body: "Fan one command across N shards. Workflows createBatch spawns up to 100 children per call, scale-to-zero between runs.",
  },
  {
    id: "RUN 03",
    title: "playwright-e2e",
    body: "Playwright end-to-end suites on Browser Rendering, sharded across the managed browser pool.",
  },
  {
    id: "RUN 04",
    title: "cdp-acceptance",
    body: "Boot an app, drive it over the Chrome DevTools Protocol, assert on network / console / heap observations.",
  },
  {
    id: "RUN 05",
    title: "security-scan",
    body: "Dependency and vulnerability scans — gated on PRs and on a weekly schedule.",
  },
  {
    id: "RUN 06",
    title: "custom-sandbox",
    body: "The escape hatch: an arbitrary container command with cache and R2 artifacts already wired in.",
  },
];

const snippets: {
  id: string;
  label: string;
  lang: "yaml" | "ts";
  blurb: string;
  code: string;
}[] = [
  {
    id: "github-actions",
    label: "GitHub Actions step",
    lang: "yaml",
    blurb:
      "Action mode — a GitHub Actions step dispatches a shipped run. About 10 s of GHA time; the heavy work runs on Cloudflare and reports back as a check.",
    code: githubActionsSrc,
  },
  {
    id: "offload-test",
    label: "Run a test suite",
    lang: "ts",
    blurb:
      "The walking skeleton — clone a repo, run any test command in a Cloudflare Sandbox, report the exit code straight to a PR check.",
    code: offloadTestSrc,
  },
  {
    id: "deploy-smoke",
    label: "Post-deploy smoke test",
    lang: "ts",
    blurb:
      "Webhook mode — fires on deployment_status.success and probes your critical URLs in parallel. Zero GHA minutes, no workflow file.",
    code: deploySmokeSrc,
  },
  {
    id: "pr-review",
    label: "AI code review",
    lang: "ts",
    blurb:
      "Webhook mode — a multi-agent AI reviewer fanned out across domains, then deduplicated by a coordinator into one verdict.",
    code: prReviewSrc,
  },
];

const shikiThemes = { light: "vitesse-light", dark: "vesper" } as const;
---

<BaseLayout
  title="FlareDispatch — offload the expensive half of GitHub Actions onto Cloudflare"
  description={site.blurb}
>
  <section class="hero">
    <div class="container">
      <div class="hero__meta">
        <span class="section-marker reveal" data-delay="1">§00 / Manifest</span>
        <span class="section-marker reveal" data-delay="1">{site.status}</span>
      </div>
      <h1 class="hero__title reveal" data-delay="2">
        Offload the <em>expensive&#160;half</em> of
        GitHub&#160;Actions onto Cloudflare.
      </h1>
      <p class="hero__sub reveal" data-delay="3">
        FlareDispatch moves Playwright e2e, acceptance suites, sharded matrices, and
        security scans off GitHub Actions and onto Cloudflare — billed per vCPU-second
        on your own account. GHA stays the trigger; runs take the heavy compute.
      </p>
      <div class="hero__cta reveal" data-delay="4">
        <a class="btn" href="/docs/prd">Read the PRD</a>
        <a class="btn btn--ghost" href="/recipes">Browse recipes</a>
      </div>
    </div>
    <HeroDiagram />
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§01 / Why it pays off</span>
        <h2>Heavy CI, at the price of raw serverless compute.</h2>
      </div>
      <div class="tenets__grid">
        {value.map((v) => (
          <article class="tenet">
            <span class="tenet__id">{v.id}</span>
            <h3 class="tenet__title">{v.title}</h3>
            <p class="tenet__rationale">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="compare">
    <div class="container">
      <div class="compare__intro">
        <div>
          <span class="section-marker">§02 / Positioning</span>
          <h2>Every option trades away one of three things. FlareDispatch keeps all three.</h2>
        </div>
        <p>
          Hosted runners are easy but billed per minute with hard ceilings; self-hosted
          and hybrid runners drop the ceilings but hand you a fleet to operate.
          FlareDispatch runs on serverless Cloudflare primitives — in the account you
          already own.
        </p>
      </div>

      <table class="compare__table">
        <thead>
          <tr>
            <th>Heavy-CI option</th>
            <th>Serverless, scale-to-zero compute</th>
            <th>No 6&#8239;h / 10&#8239;GB ceilings</th>
            <th>No runner fleet to operate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>GHA hosted runners</td>
            <td class="compare__no">—</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
          </tr>
          <tr>
            <td>Self-hosted runners</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
            <td class="compare__no">—</td>
          </tr>
          <tr>
            <td>Buildkite Agent (hybrid)</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
            <td class="compare__no">—</td>
          </tr>
          <tr class="is-flaredispatch">
            <td>FlareDispatch</td>
            <td class="compare__yes">✓</td>
            <td class="compare__yes">✓</td>
            <td class="compare__yes">✓</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§03 / What ships</span>
        <h2>Six runs in the box. The DSL is the contract.</h2>
      </div>
      <div class="tenets__grid">
        {runs.map((r) => (
          <article class="tenet">
            <span class="tenet__id">{r.id}</span>
            <h3 class="tenet__title">{r.title}</h3>
            <p class="tenet__rationale">{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="snippets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§04 / The code</span>
        <h2>Two ways in — a GitHub Actions step, or a typed run.</h2>
      </div>
      <div class="snippets__widget">
        <div class="snippets__tabs" role="tablist" aria-label="Run examples">
          {snippets.map((s, i) => (
            <button
              type="button"
              class="snippets__tab"
              role="tab"
              id={`snippet-tab-${s.id}`}
              aria-controls={`snippet-panel-${s.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-snippet-tab={s.id}
            >
              {s.label}
            </button>
          ))}
        </div>
        {snippets.map((s, i) => (
          <div
            class="snippets__panel"
            role="tabpanel"
            id={`snippet-panel-${s.id}`}
            aria-labelledby={`snippet-tab-${s.id}`}
            data-snippet-panel={s.id}
            hidden={i !== 0}
          >
            <p class="snippets__blurb">{s.blurb}</p>
            <Code code={s.code} lang={s.lang} themes={shikiThemes} defaultColor="light" wrap />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="container">
      <div class="manifesto__header">
        <span class="section-marker">§05 / Design philosophy</span>
        <h2>Three bets the design is built on.</h2>
      </div>
      <ol class="manifesto__list">
        <li class="manifesto__item">
          <span class="manifesto__num">§05.01</span>
          <div>
            <p class="manifesto__statement"><strong>Progressive</strong> offloading.</p>
            <p class="manifesto__body">Move CI to Cloudflare one job at a time — the heaviest, most expensive jobs first. GitHub Actions stays the trigger and keeps the cheap jobs; nothing is all-or-nothing.</p>
          </div>
        </li>
        <li class="manifesto__item">
          <span class="manifesto__num">§05.02</span>
          <div>
            <p class="manifesto__statement">Runs are <strong>typed programs</strong>, not YAML.</p>
            <p class="manifesto__body">A run is an Effect-TS program — Schema-typed inputs and outputs, composable steps, tagged errors, exhaustive matching. Fork it, vendor-edit it, unit-test it without booting a container.</p>
          </div>
        </li>
        <li class="manifesto__item">
          <span class="manifesto__num">§05.03</span>
          <div>
            <p class="manifesto__statement">BYOC <strong>by construction</strong>.</p>
            <p class="manifesto__body">Every code path assumes the run is deployed in your own Cloudflare account — no multi-tenant operator, no hosted SaaS to trust. The specs are the contract; the runs are yours.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="container">
    <div class="cta-band">
      <div>
        <span class="section-marker">§06 / Read on</span>
        <h2>Pre-implementation. The specs are the contract.</h2>
      </div>
      <div class="cta-band__actions">
        <a class="btn" href="/docs/prd">Open the PRD</a>
        <a class="btn btn--ghost" href="/recipes">Browse recipes</a>
      </div>
    </div>
  </section>

  <script>
    for (const tab of document.querySelectorAll("[data-snippet-tab]")) {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-snippet-tab");
        for (const t of document.querySelectorAll("[data-snippet-tab]")) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        for (const p of document.querySelectorAll("[data-snippet-panel]")) {
          p.toggleAttribute("hidden", p.getAttribute("data-snippet-panel") !== id);
        }
      });
    }
  </script>
</BaseLayout>
