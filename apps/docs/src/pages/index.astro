---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDiagram from "../components/HeroDiagram.astro";
import BillingTimeline from "../components/BillingTimeline.astro";
import { site } from "../lib/site";
import { recipes } from "../lib/recipes";
import { readRecipeFile } from "../lib/recipe-files";

const value = [
  {
    id: "01 / Cost",
    title: "Pay per vCPU-second",
    body: "Heavy compute is billed at Cloudflare Container rates — per vCPU-second, scale-to-zero between runs — instead of GitHub Actions per-minute. The jobs that dominate your CI bill move to the cheapest place to run them.",
  },
  {
    id: "02 / Headroom",
    title: "No platform ceilings",
    body: "No 6-hour job limit. No 10 GB cache cap. Artifact retention you set, not a fixed 90 days. The limits that push teams onto self-hosted runners simply aren't there.",
  },
  {
    id: "03 / Fit",
    title: "Drops into your setup",
    body: "Keep GitHub Actions as your trigger and PR gate, or let runs fire autonomously from the GitHub App or a cron schedule. One wrangler deploy into the Cloudflare account you already pay for. Results land as a GitHub Check Run — no new dashboard, no runner fleet to operate.",
  },
];

// §03 mirrors the /recipes catalog exactly — each recipe, with its source
// files read from the monorepo-root recipes/ directory at build time.
const recipeSnippets = recipes.map((recipe) => ({
  ...recipe,
  sources: recipe.files.map((file) => ({
    file,
    code: readRecipeFile(recipe.slug, file.name),
  })),
}));

const shikiThemes = { light: "vitesse-light", dark: "vesper" } as const;
---

<BaseLayout
  title="FlareDispatch — offload the expensive half of GitHub Actions onto Cloudflare"
  description={site.blurb}
>
  <section class="hero">
    <div class="container">
      <div class="hero__meta">
        <span class="section-marker reveal" data-delay="1">§00 / Manifest</span>
        <span class="section-marker reveal" data-delay="1">{site.status}</span>
      </div>
      <h1 class="hero__title reveal" data-delay="2">
        Offload the <em>expensive&#160;half</em> of
        GitHub&#160;Actions onto Cloudflare.
      </h1>
      <p class="hero__sub reveal" data-delay="3">
        FlareDispatch moves agentic code review, Playwright e2e, acceptance suites,
        sharded matrices, and security scans off GitHub Actions and onto Cloudflare —
        billed per vCPU-second on your own account. Trigger a run from GitHub Actions,
        the GitHub App, or a cron schedule; runs take the heavy compute.
      </p>
      <div class="hero__cta reveal" data-delay="4">
        <a class="btn" href="/docs/prd">Read the PRD</a>
        <a class="btn btn--ghost" href="/recipes">Browse recipes</a>
      </div>
    </div>
    <HeroDiagram />
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§01 / Why it pays off</span>
        <h2>Heavy CI, at the price of raw serverless compute.</h2>
      </div>
      <div class="tenets__grid">
        {value.map((v) => (
          <article class="tenet">
            <span class="tenet__id">{v.id}</span>
            <h3 class="tenet__title">{v.title}</h3>
            <p class="tenet__rationale">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bottleneck">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§02 / The bottleneck</span>
        <h2>Most of a code-review run is the model thinking, not your CPU working.</h2>
        <p class="bottleneck__lede">
          An agentic review is mostly LLM I/O — the run sits blocked on the model
          while the vCPU is idle. GitHub Actions bills that wait by the wall-clock
          minute. FlareDispatch runs on Cloudflare Containers, billed per
          vCPU-second, so the idle wait scales toward zero and you pay for the
          <em>active</em> slivers — here, roughly a fifth of the run.
        </p>
      </div>
      <BillingTimeline />
    </div>
  </section>

  <section class="compare">
    <div class="container">
      <div class="compare__intro">
        <div>
          <span class="section-marker">§03 / Positioning</span>
          <h2>Every option trades away one of three things. FlareDispatch keeps all three.</h2>
        </div>
        <p>
          Hosted runners are easy but billed per minute with hard ceilings; self-hosted
          and hybrid runners drop the ceilings but hand you a fleet to operate.
          FlareDispatch runs on serverless Cloudflare primitives — in the account you
          already own.
        </p>
      </div>

      <table class="compare__table">
        <thead>
          <tr>
            <th>Heavy-CI option</th>
            <th>Serverless, scale-to-zero compute</th>
            <th>No 6&#8239;h / 10&#8239;GB ceilings</th>
            <th>No runner fleet to operate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>GHA hosted runners</td>
            <td class="compare__no">—</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
          </tr>
          <tr>
            <td>Self-hosted runners</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
            <td class="compare__no">—</td>
          </tr>
          <tr>
            <td>Buildkite Agent (hybrid)</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
            <td class="compare__no">—</td>
          </tr>
          <tr class="is-flare-dispatch">
            <td>FlareDispatch</td>
            <td class="compare__yes">✓</td>
            <td class="compare__yes">✓</td>
            <td class="compare__yes">✓</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="snippets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§04 / The code</span>
        <h2>Every recipe — toggle the workflow against its typed run.</h2>
      </div>
      <div class="snippets__widget">
        <div class="snippets__tabs" role="tablist" aria-label="Recipes">
          {recipeSnippets.map((r, i) => (
            <button
              type="button"
              class="snippets__tab"
              role="tab"
              id={`recipe-tab-${r.slug}`}
              aria-controls={`recipe-panel-${r.slug}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-tab="recipe"
              data-target={`recipe-panel-${r.slug}`}
            >
              {r.label}
            </button>
          ))}
        </div>
        {recipeSnippets.map((r, i) => (
          <div
            class="snippets__panel"
            role="tabpanel"
            id={`recipe-panel-${r.slug}`}
            aria-labelledby={`recipe-tab-${r.slug}`}
            data-panel="recipe"
            hidden={i !== 0}
          >
            <div class="snippets__blurb">
              <span>{r.useCase}. <em>Recommended: {r.mode} mode.</em></span>
              <a href={`/recipes/${r.slug}`}>Full recipe →</a>
            </div>
            <div class="snippets__subtabs" role="tablist" aria-label={`${r.label} source files`}>
              {r.sources.map((s, j) => (
                <button
                  type="button"
                  class="snippets__subtab"
                  role="tab"
                  id={`file-tab-${r.slug}-${j}`}
                  aria-controls={`file-panel-${r.slug}-${j}`}
                  aria-selected={j === 0 ? "true" : "false"}
                  data-tab={`files-${r.slug}`}
                  data-target={`file-panel-${r.slug}-${j}`}
                >
                  <span class="snippets__subtab-lang">{s.file.lang}</span>
                  {s.file.name}
                </button>
              ))}
            </div>
            {r.sources.map((s, j) => (
              <div
                class="snippets__subpanel"
                role="tabpanel"
                id={`file-panel-${r.slug}-${j}`}
                aria-labelledby={`file-tab-${r.slug}-${j}`}
                data-panel={`files-${r.slug}`}
                hidden={j !== 0}
              >
                <Code code={s.code} lang={s.file.lang} themes={shikiThemes} defaultColor="light" wrap />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="container">
      <div class="manifesto__header">
        <span class="section-marker">§05 / Design philosophy</span>
        <h2>Three bets the design is built on.</h2>
      </div>
      <ol class="manifesto__list">
        <li class="manifesto__item">
          <span class="manifesto__num">§05.01</span>
          <div>
            <p class="manifesto__statement"><strong>Progressive</strong> offloading.</p>
            <p class="manifesto__body">Move CI to Cloudflare one job at a time — the heaviest, most expensive jobs first. GitHub Actions keeps the cheap jobs and the PR gate; nothing is all-or-nothing.</p>
          </div>
        </li>
        <li class="manifesto__item">
          <span class="manifesto__num">§05.02</span>
          <div>
            <p class="manifesto__statement">Runs are <strong>typed programs</strong>, not YAML.</p>
            <p class="manifesto__body">A run is an Effect-TS program — Schema-typed inputs and outputs, composable steps, tagged errors, exhaustive matching. Fork it, vendor-edit it, unit-test it without booting a container.</p>
          </div>
        </li>
        <li class="manifesto__item">
          <span class="manifesto__num">§05.03</span>
          <div>
            <p class="manifesto__statement">BYOC <strong>by construction</strong>.</p>
            <p class="manifesto__body">Every code path assumes the run is deployed in your own Cloudflare account — no multi-tenant operator, no hosted SaaS to trust. The specs are the contract; the runs are yours.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="container">
    <div class="cta-band">
      <div>
        <span class="section-marker">§06 / Read on</span>
        <h2>Pre-implementation. The specs are the contract.</h2>
      </div>
      <div class="cta-band__actions">
        <a class="btn" href="/docs/prd">Open the PRD</a>
        <a class="btn btn--ghost" href="/recipes">Browse recipes</a>
      </div>
    </div>
  </section>

  <script>
    // Generic tab controller — drives both the recipe tabs and the nested
    // per-recipe file (yaml / ts) sub-tabs. A tab carries `data-tab="<group>"`
    // and `data-target="<panelId>"`; panels carry `data-panel="<group>"`.
    for (const tab of document.querySelectorAll<HTMLElement>("[data-tab]")) {
      tab.addEventListener("click", () => {
        const group = tab.getAttribute("data-tab");
        const target = tab.getAttribute("data-target");
        for (const t of document.querySelectorAll(`[data-tab="${group}"]`)) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        for (const p of document.querySelectorAll<HTMLElement>(`[data-panel="${group}"]`)) {
          p.toggleAttribute("hidden", p.id !== target);
        }
      });
    }
  </script>
</BaseLayout>
