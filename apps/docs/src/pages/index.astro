---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDiagram from "../components/HeroDiagram.astro";
import BillingTimeline from "../components/BillingTimeline.astro";
import { site } from "../lib/site";
import { recipes } from "../lib/recipes";
import { readRecipeFile } from "../lib/recipe-files";

const value = [
  {
    id: "01 / Cost",
    title: "Pay per vCPU-second",
    body: "Heavy compute is billed at Cloudflare Container rates — per vCPU-second, scale-to-zero between runs — instead of GitHub Actions per-minute. The jobs that dominate your CI bill move to the cheapest place to run them.",
  },
  {
    id: "02 / Headroom",
    title: "No platform ceilings",
    body: "No 6-hour job limit. No 10 GB cache cap. Artifact retention you set, not a fixed 90 days. The limits that push teams onto self-hosted runners simply aren't there.",
  },
  {
    id: "03 / Fit",
    title: "Drops into your setup",
    body: "Keep GitHub Actions as your trigger and PR gate, or let runs fire autonomously from the GitHub App or a cron schedule. One wrangler deploy into the Cloudflare account you already pay for. Results land as a GitHub Check Run — no new dashboard, no runner fleet to operate.",
  },
];

// §05 / Platform — shipped capabilities that sit underneath the runs (every
// claim here is live at HEAD; the GitHub App webhook, observability-signal
// ingestion, and email notify are shipped but opt-in / off by default).
const capabilities = [
  {
    id: "05.01 / Agentic review",
    title: "Review runs that read the whole diff",
    body: "The pr-review run reviews every diff in-Worker — configurable single- or multi-agent — and posts a scannable verdict: a summary table, per-finding headings, and GitHub blob links. Re-reviews are authoritative and auto-resolve findings you've fixed.",
  },
  {
    id: "05.02 / Writeback",
    title: "Propose the fix back as a PR",
    body: "A run can return a changed-files manifest from its credential-free container; the Dispatcher validates it and opens a pull request via the Git Data API. Best-effort — a writeback failure annotates the green check, it never flips the run red.",
  },
  {
    id: "05.03 / Model routing",
    title: "Provider-agnostic model gateway",
    body: "Route model calls to Workers AI, Anthropic, reasonix, or Amazon Bedrock — Bedrock through the AI Gateway forwarder with an OIDC → STS → SigV4 trust path, no long-lived AWS keys in Worker Secrets. Swap the backend from KV config with no redeploy.",
  },
  {
    id: "05.04 / Admission control",
    title: "Bursts queue, they don't fail red",
    body: "A global FIFO admission queue caps in-flight runs at the container-pool size; work beyond capacity queues and drains in order instead of erroring. Per-container leases serialize runs that normalize to the same sandbox container id (ContainerBusy after ~10 min).",
  },
  {
    id: "05.05 / Session replay",
    title: "Scrub the walkthrough inline",
    body: "product-demo drives a deployed app over CDP with native session recording; reviewers replay the run in a self-hosted rrweb player, linked straight from the check summary and the result email.",
  },
  {
    id: "05.06 / Three trigger modes",
    title: "Action, Schedule, or Webhook",
    body: "Fire a run from a GitHub Actions step, a Cloudflare Cron Trigger, or the GitHub App webhook (opt-in) — one Dispatcher, every result posted back as a GitHub Check Run.",
  },
  {
    id: "05.07 / Observability signals",
    title: "Bring your own APM, vendor-blind",
    body: "ci-triage-pr stays vendor-blind — it never queries your APM. Instead, a tiny consumer-side adapter (Datadog, SigNoz, HyperDX, or your own) prints the normalized signals/v1 shape next to your own credentials and feeds it into the run's signals input. The narrow-waist contract means any vendor is supported on day one without the Dispatcher ever holding an observability key.",
  },
  {
    id: "05.08 / Email notify",
    title: "Results land in the inbox, not just the PR",
    body: "A run can email a completion summary over Cloudflare Email Routing — a stakeholder-facing product-demo with the rrweb replay one click away, or a run-authored failure summary. Opt-in and default-secure: a logged no-op until the send_email binding is configured, with an optional EMAIL_ALLOWED_RECIPIENTS allowlist on top of Cloudflare's verified-destination-address constraint.",
  },
];

// §06 / Dogfood — both runs fire on this very repo. Each card shows the real
// artifact a run posts back: pr-review's verdict comment on the PR, and
// product-demo's walkthrough GIF. The media lives in /public/showcase/ —
// committed captures from actual flare-dispatch runs. pr-review.png is the real
// review left on PR #138 (the PR that added this section); product-demo is still
// a placeholder SVG until the demo run is unblocked (swap → product-demo.gif).
const showcases = [
  {
    tag: "pr-review",
    badge: "💬 Comment",
    title: "The review lands on the pull request",
    body: "pr-review reads every file in the diff in-Worker, dedups across domain reviewers, and posts one verdict comment — a severity summary table, per-finding headings, and GitHub blob links — on every PR to this repo. This is a real review it left on the PR that added this very section.",
    media: "/showcase/pr-review.png",
    mediaAlt:
      "Real FlareDispatch pr-review verdict comment from flaredispatch[bot] on a flare-dispatch pull request: an 'AI code review — 💬 Comment' header, a risk-tier line, a per-domain reviewer breakdown, a severity summary table, and per-finding details linking to GitHub blob lines.",
    width: 1616,
    height: 1254,
    recipe: { href: "/recipes/ai-code-review", label: "Recipe →" },
    github: {
      href: `${site.repo}/pull/138#pullrequestreview-4493236314`,
      label: "On GitHub",
    },
  },
  {
    tag: "product-demo",
    badge: "Walkthrough GIF",
    title: "The walkthrough drops back as a GIF",
    body: "product-demo drives the deployed app over CDP with native session recording, stitches the per-chapter frames into one ≤10 MB walkthrough GIF, and posts it inline on the PR — alongside an rrweb replay linked from the check run.",
    // TODO: replace with the captured walkthrough → /showcase/product-demo.gif
    media: "/showcase/product-demo.svg",
    mediaAlt:
      "Animated walkthrough GIF recorded by FlareDispatch product-demo, posted inline as a PR comment on the flare-dispatch repo.",
    width: 1280,
    height: 800,
    recipe: { href: "/recipes/product-demo", label: "Recipe →" },
    github: { href: `${site.repo}/pull/132`, label: "On GitHub" },
  },
];

// §03 mirrors the /recipes catalog exactly — each recipe, with its source
// files read from the monorepo-root recipes/ directory at build time.
const recipeSnippets = recipes.map((recipe) => ({
  ...recipe,
  sources: recipe.files.map((file) => ({
    file,
    code: readRecipeFile(recipe.slug, file.name),
  })),
}));

const shikiThemes = { light: "vitesse-light", dark: "vesper" } as const;
---

<BaseLayout
  title="FlareDispatch — offload the expensive half of GitHub Actions onto Cloudflare"
  description={site.blurb}
>
  <section class="hero">
    <div class="container">
      <div class="hero__meta">
        <span class="section-marker reveal" data-delay="1">§00 / Manifest</span>
        <span class="section-marker reveal" data-delay="1">{site.status}</span>
      </div>
      <h1 class="hero__title reveal" data-delay="2">
        Offload the <em>expensive&#160;half</em> of
        GitHub&#160;Actions onto Cloudflare.
      </h1>
      <p class="hero__sub reveal" data-delay="3">
        FlareDispatch moves agentic code review, Playwright e2e, acceptance suites,
        sharded matrices, and security scans off GitHub Actions and onto Cloudflare —
        billed per vCPU-second on your own account. Trigger a run from GitHub Actions,
        the GitHub App, or a cron schedule; runs take the heavy compute.
      </p>
      <div class="hero__cta reveal" data-delay="4">
        <a class="btn" href="/docs/prd">Read the PRD</a>
        <a class="btn btn--ghost" href={`${site.repo}#quickstart`}>Quickstart</a>
        <a class="btn btn--ghost" href="/recipes">Browse recipes</a>
      </div>
    </div>
    <HeroDiagram />
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§01 / Why it pays off</span>
        <h2>Heavy CI, at the price of raw serverless compute.</h2>
      </div>
      <div class="tenets__grid">
        {value.map((v) => (
          <article class="tenet">
            <span class="tenet__id">{v.id}</span>
            <h3 class="tenet__title">{v.title}</h3>
            <p class="tenet__rationale">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bottleneck">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§02 / The bottleneck</span>
        <h2>Most of a code-review run is the model thinking, not your CPU working.</h2>
        <p class="bottleneck__lede">
          An agentic review is mostly LLM I/O — the run sits blocked on the model
          while the vCPU is idle. GitHub Actions bills that wait by the wall-clock
          minute. FlareDispatch runs on Cloudflare Containers, billed per
          vCPU-second, so the idle wait scales toward zero and you pay for the
          <em>active</em> slivers — here, roughly a fifth of the run.
        </p>
      </div>
      <div class="bottleneck__split">
        <BillingTimeline />
        <aside class="cost-card" aria-label="Sample cost for one 10-minute code-review run">
          <span class="cost-card__eyebrow">Sample cost · one 10-min review</span>
          <table class="cost-card__table">
            <thead>
              <tr>
                <th>Runner config</th>
                <th>$&#8239;/&#8239;min</th>
                <th>/ run</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row"><code>ubuntu-latest</code><span class="cost-card__sub">2-core · GHA</span></th>
                <td>0.008</td>
                <td>$0.080</td>
              </tr>
              <tr>
                <th scope="row"><code>ubuntu-latest-4-core</code><span class="cost-card__sub">4-core · GHA</span></th>
                <td>0.016</td>
                <td>$0.160</td>
              </tr>
              <tr>
                <th scope="row"><code>ubuntu-latest-8-core</code><span class="cost-card__sub">8-core · GHA</span></th>
                <td>0.032</td>
                <td>$0.320</td>
              </tr>
              <tr class="cost-card__total">
                <th scope="row"><code>flare-dispatch</code><span class="cost-card__sub">~2&#8239;min vCPU-active</span></th>
                <td>vCPU-s</td>
                <td class="cost-card__win">~$0.004</td>
              </tr>
            </tbody>
          </table>
          <p class="cost-card__verdict">20–80× cheaper per run</p>
          <p class="cost-card__note">
            Code review is I/O-bound — it never needs the cores, yet GitHub bills the
            full 10&#8239;min wall-clock at the runner's rate, so a bigger box only
            widens the gap. FlareDispatch bills the ~2&#8239;min of vCPU-active work
            ($0.000020&#8239;/&#8239;vCPU-s); the model-wait sits in a CPU-time-billed
            Workflow step and costs nothing. CI compute only — model tokens are billed
            identically either way. Larger-runner labels illustrative; rates from the
            <a href="/docs/06-cost">cost spec</a>.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="compare">
    <div class="container">
      <div class="compare__intro">
        <div>
          <span class="section-marker">§03 / Positioning</span>
          <h2>Every option trades away one of three things. FlareDispatch keeps all three.</h2>
        </div>
        <p>
          Hosted runners are easy but billed per minute with hard ceilings; self-hosted
          and hybrid runners drop the ceilings but hand you a fleet to operate.
          FlareDispatch runs on serverless Cloudflare primitives — in the account you
          already own.
        </p>
      </div>

      <table class="compare__table">
        <thead>
          <tr>
            <th>Heavy-CI option</th>
            <th>Serverless, scale-to-zero compute</th>
            <th>No 6&#8239;h / 10&#8239;GB ceilings</th>
            <th>No runner fleet to operate</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>GHA hosted runners</td>
            <td class="compare__no">—</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
          </tr>
          <tr>
            <td>Self-hosted runners</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
            <td class="compare__no">—</td>
          </tr>
          <tr>
            <td>Buildkite Agent (hybrid)</td>
            <td class="compare__no">—</td>
            <td class="compare__yes">✓</td>
            <td class="compare__no">—</td>
          </tr>
          <tr class="is-flare-dispatch">
            <td>FlareDispatch</td>
            <td class="compare__yes">✓</td>
            <td class="compare__yes">✓</td>
            <td class="compare__yes">✓</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="snippets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§04 / The code</span>
        <h2>Every recipe — toggle the workflow against its typed run.</h2>
      </div>
      <div class="snippets__widget">
        <div class="snippets__tabs" role="tablist" aria-label="Recipes">
          {recipeSnippets.map((r, i) => (
            <button
              type="button"
              class="snippets__tab"
              role="tab"
              id={`recipe-tab-${r.slug}`}
              aria-controls={`recipe-panel-${r.slug}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-tab="recipe"
              data-target={`recipe-panel-${r.slug}`}
            >
              {r.label}
            </button>
          ))}
        </div>
        {recipeSnippets.map((r, i) => (
          <div
            class="snippets__panel"
            role="tabpanel"
            id={`recipe-panel-${r.slug}`}
            aria-labelledby={`recipe-tab-${r.slug}`}
            data-panel="recipe"
            hidden={i !== 0}
          >
            <div class="snippets__blurb">
              <span>{r.useCase}. <em>Recommended: {r.mode} mode.</em></span>
              <a href={`/recipes/${r.slug}`}>Full recipe →</a>
            </div>
            <div class="snippets__subtabs" role="tablist" aria-label={`${r.label} source files`}>
              {r.sources.map((s, j) => (
                <button
                  type="button"
                  class="snippets__subtab"
                  role="tab"
                  id={`file-tab-${r.slug}-${j}`}
                  aria-controls={`file-panel-${r.slug}-${j}`}
                  aria-selected={j === 0 ? "true" : "false"}
                  data-tab={`files-${r.slug}`}
                  data-target={`file-panel-${r.slug}-${j}`}
                >
                  <span class="snippets__subtab-lang">{s.file.lang}</span>
                  {s.file.name}
                </button>
              ))}
            </div>
            {r.sources.map((s, j) => (
              <div
                class="snippets__subpanel"
                role="tabpanel"
                id={`file-panel-${r.slug}-${j}`}
                aria-labelledby={`file-tab-${r.slug}-${j}`}
                data-panel={`files-${r.slug}`}
                hidden={j !== 0}
              >
                <Code code={s.code} lang={s.file.lang} themes={shikiThemes} defaultColor="light" wrap />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tenets">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§05 / Platform</span>
        <h2>More than runs — the platform underneath.</h2>
      </div>
      <div class="tenets__grid">
        {capabilities.map((c) => (
          <article class="tenet">
            <span class="tenet__id">{c.id}</span>
            <h3 class="tenet__title">{c.title}</h3>
            <p class="tenet__rationale">{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase">
    <div class="container">
      <div class="tenets__header">
        <span class="section-marker">§06 / Dogfood</span>
        <h2>Dogfooded on this repo.</h2>
        <p class="showcase__lede">
          FlareDispatch reviews its own pull requests and records its own
          walkthroughs. Each artifact below is the real output of a run on
          <a href={site.repo}>OpenHackersClub/flare-dispatch</a> — two of the
          recipes shown above, fired on this codebase.
        </p>
      </div>
      <div class="showcase__grid">
        {showcases.map((s) => (
          <article class="showcase__card">
            <header class="showcase__head">
              <span class="showcase__tag">{s.tag}</span>
              <span class="showcase__badge">{s.badge}</span>
            </header>
            <h3 class="showcase__title">{s.title}</h3>
            <p class="showcase__body">{s.body}</p>
            <figure class="showcase__figure">
              <img
                class="showcase__media"
                src={s.media}
                alt={s.mediaAlt}
                width={s.width}
                height={s.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="showcase__links">
              <a class="showcase__link showcase__link--strong" href={s.github.href}>{s.github.label} ↗</a>
              <a class="showcase__link" href={s.recipe.href}>{s.recipe.label}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="container">
      <div class="manifesto__header">
        <span class="section-marker">§07 / Design philosophy</span>
        <h2>Three bets the design is built on.</h2>
      </div>
      <ol class="manifesto__list">
        <li class="manifesto__item">
          <span class="manifesto__num">§07.01</span>
          <div>
            <p class="manifesto__statement"><strong>Progressive</strong> offloading.</p>
            <p class="manifesto__body">Move CI to Cloudflare one job at a time — the heaviest, most expensive jobs first. GitHub Actions keeps the cheap jobs and the PR gate; nothing is all-or-nothing.</p>
          </div>
        </li>
        <li class="manifesto__item">
          <span class="manifesto__num">§07.02</span>
          <div>
            <p class="manifesto__statement">Runs are <strong>typed programs</strong>, not YAML.</p>
            <p class="manifesto__body">A run is an Effect-TS program — Schema-typed inputs and outputs, composable steps, tagged errors, exhaustive matching. Fork it, vendor-edit it, unit-test it without booting a container.</p>
          </div>
        </li>
        <li class="manifesto__item">
          <span class="manifesto__num">§07.03</span>
          <div>
            <p class="manifesto__statement">BYOC <strong>by construction</strong>.</p>
            <p class="manifesto__body">Every code path assumes the run is deployed in your own Cloudflare account — no multi-tenant operator, no hosted SaaS to trust. The specs are the contract; the runs ship at HEAD and are yours to fork.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="container">
    <div class="cta-band">
      <div>
        <span class="section-marker">§08 / Read on</span>
        <h2>Live at HEAD. The specs are the contract; the runs are shipped.</h2>
      </div>
      <div class="cta-band__actions">
        <a class="btn" href="/docs/prd">Open the PRD</a>
        <a class="btn btn--ghost" href={`${site.repo}#quickstart`}>Quickstart</a>
        <a class="btn btn--ghost" href="/recipes">Browse recipes</a>
      </div>
    </div>
  </section>

  <script>
    // Generic tab controller — drives both the recipe tabs and the nested
    // per-recipe file (yaml / ts) sub-tabs. A tab carries `data-tab="<group>"`
    // and `data-target="<panelId>"`; panels carry `data-panel="<group>"`.
    for (const tab of document.querySelectorAll<HTMLElement>("[data-tab]")) {
      tab.addEventListener("click", () => {
        const group = tab.getAttribute("data-tab");
        const target = tab.getAttribute("data-target");
        for (const t of document.querySelectorAll(`[data-tab="${group}"]`)) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        for (const p of document.querySelectorAll<HTMLElement>(`[data-panel="${group}"]`)) {
          p.toggleAttribute("hidden", p.id !== target);
        }
      });
    }
  </script>
</BaseLayout>
