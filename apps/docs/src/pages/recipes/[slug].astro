---
import { getCollection, render } from "astro:content";
import { Code } from "astro:components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeSidebar from "../../components/RecipeSidebar.astro";
import MermaidRunner from "../../components/MermaidRunner.astro";
import { recipes } from "../../lib/recipes";
import { readRecipeFile } from "../../lib/recipe-files";

export async function getStaticPaths() {
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;

// Adjacent recipes for the prev/next footer.
const idx = recipes.findIndex((r) => r.slug === recipe.slug);
const prev = idx > 0 ? recipes[idx - 1] : undefined;
const next = idx < recipes.length - 1 ? recipes[idx + 1] : undefined;

// Optional per-recipe README, rendered as prose.
const readmeEntries = recipe.hasReadme ? await getCollection("recipes") : [];
const readmeEntry = readmeEntries.find(
  (e) => e.id.toLowerCase() === `${recipe.slug}/readme`,
);
const Readme = readmeEntry ? (await render(readmeEntry)).Content : undefined;

// FlareDispatch source files (typed run(s) + thin dispatch workflow).
const flareFiles = recipe.files.map((file) => ({
  file,
  code: readRecipeFile(recipe.slug, file.name),
}));

// Baseline GHA workflow — what teams write WITHOUT FlareDispatch. Recipes
// added since the comparison widget shipped may not have a baseline yet; in
// that case the page falls back to the single-Source layout.
const baselineCode = recipe.baseline
  ? readRecipeFile(recipe.slug, recipe.baseline.name)
  : undefined;

const shikiThemes = { light: "vitesse-light", dark: "vesper" } as const;

const modeOneLiner: Record<typeof recipe.mode, string> = {
  Action: "triggered by a GitHub Actions workflow that calls the shipped run.",
  Webhook: "triggered directly by the FlareDispatch GitHub App webhook — zero GHA minutes.",
  Schedule: "triggered by a Cloudflare Cron Trigger on a wall-clock cadence — no GitHub event needed.",
};

// Tab group id — scoped per recipe so multiple recipe pages don't collide.
const tabGroup = `compare-${recipe.slug}`;
const fileSubGroup = `compare-files-${recipe.slug}`;
---

<BaseLayout
  title={`${recipe.label} — FlareDispatch recipes`}
  description={recipe.blurb}
>
  <div class="docs-shell docs-shell--recipe">
    <RecipeSidebar currentSlug={recipe.slug} />
    <article>
      <header class="doc-header">
        <div class="doc-header__crumb">
          <a href="/recipes">Recipes</a>
          <span class="sep">/</span>
          <span>{recipe.mode} mode</span>
        </div>
        <h1>{recipe.label}</h1>
      </header>

      <p class="recipe-lede">{recipe.blurb}</p>

      <dl class="recipe-meta">
        <div>
          <dt>Use case</dt>
          <dd>{recipe.useCase}</dd>
        </div>
        <div>
          <dt>Recommended mode</dt>
          <dd>{recipe.mode}</dd>
        </div>
        {
          recipe.shape && (
            <>
              <div>
                <dt>FlareDispatch shape</dt>
                <dd>{recipe.shape.flare}</dd>
              </div>
              <div>
                <dt>Plain GHA shape</dt>
                <dd>{recipe.shape.gha}</dd>
              </div>
            </>
          )
        }
        {
          !recipe.shape && (
            <div>
              <dt>Files</dt>
              <dd>{recipe.files.map((f) => f.name).join(", ")}</dd>
            </div>
          )
        }
      </dl>

      {
        Readme && (
          <div class="prose">
            <Readme />
          </div>
        )
      }

      {recipe.baseline && baselineCode && (
      <section class="recipe-compare">
        <header class="recipe-compare__header">
          <h2>Source</h2>
          <p class="recipe-compare__note">
            The recommended FlareDispatch shape is shown first. Toggle to
            <em>Without FlareDispatch</em> to see the full GitHub Actions
            workflow a team would maintain to do the same job without it.
          </p>
        </header>

        <div class="recipe-compare__widget">
          <div
            class="recipe-compare__tabs"
            role="tablist"
            aria-label={`${recipe.label} — implementation comparison`}
          >
            <button
              type="button"
              class="recipe-compare__tab recipe-compare__tab--flare"
              role="tab"
              id={`${tabGroup}-flare-tab`}
              aria-controls={`${tabGroup}-flare-panel`}
              aria-selected="true"
              data-tab={tabGroup}
              data-target={`${tabGroup}-flare-panel`}
            >
              <span class="recipe-compare__tab-mark">●</span>
              With FlareDispatch
            </button>
            <button
              type="button"
              class="recipe-compare__tab recipe-compare__tab--baseline"
              role="tab"
              id={`${tabGroup}-baseline-tab`}
              aria-controls={`${tabGroup}-baseline-panel`}
              aria-selected="false"
              data-tab={tabGroup}
              data-target={`${tabGroup}-baseline-panel`}
            >
              <span class="recipe-compare__tab-mark">○</span>
              Without FlareDispatch
              <span class="recipe-compare__tab-meta">plain GHA</span>
            </button>
          </div>

          <!-- Panel 1: WITH FlareDispatch — the recommended approach. -->
          <div
            class="recipe-compare__panel"
            role="tabpanel"
            id={`${tabGroup}-flare-panel`}
            aria-labelledby={`${tabGroup}-flare-tab`}
            data-panel={tabGroup}
          >
            <div class="recipe-compare__blurb">
              <span><em>{recipe.mode} mode</em> — {modeOneLiner[recipe.mode]}</span>
            </div>

            <div
              class="recipe-compare__subtabs"
              role="tablist"
              aria-label={`${recipe.label} — FlareDispatch source files`}
            >
              {flareFiles.map(({ file }, j) => (
                <button
                  type="button"
                  class="recipe-compare__subtab"
                  role="tab"
                  id={`${fileSubGroup}-${j}-tab`}
                  aria-controls={`${fileSubGroup}-${j}-panel`}
                  aria-selected={j === 0 ? "true" : "false"}
                  data-tab={fileSubGroup}
                  data-target={`${fileSubGroup}-${j}-panel`}
                >
                  <span class="recipe-compare__subtab-lang">{file.lang}</span>
                  {file.name}
                  {recipe.mode !== "Action" && file.name === "ci.yml" && (
                    <span class="recipe-compare__subtab-opt">optional</span>
                  )}
                </button>
              ))}
            </div>

            {flareFiles.map(({ file, code }, j) => (
              <figure
                class="recipe-compare__file"
                id={`${fileSubGroup}-${j}-panel`}
                role="tabpanel"
                aria-labelledby={`${fileSubGroup}-${j}-tab`}
                data-panel={fileSubGroup}
                hidden={j !== 0}
              >
                <figcaption>recipes/{recipe.slug}/{file.name}</figcaption>
                <Code
                  code={code}
                  lang={file.lang}
                  themes={shikiThemes}
                  defaultColor="light"
                  wrap
                />
              </figure>
            ))}
          </div>

          <!-- Panel 2: WITHOUT FlareDispatch — the baseline GHA workflow. -->
          <div
            class="recipe-compare__panel"
            role="tabpanel"
            id={`${tabGroup}-baseline-panel`}
            aria-labelledby={`${tabGroup}-baseline-tab`}
            data-panel={tabGroup}
            hidden
          >
            <div class="recipe-compare__blurb recipe-compare__blurb--baseline">
              <span>
                A faithful, runnable GHA workflow — what a team actually
                maintains to do this job without FlareDispatch.
              </span>
            </div>

            <figure class="recipe-compare__file recipe-compare__file--baseline">
              <figcaption>recipes/{recipe.slug}/{recipe.baseline.name}</figcaption>
              <Code
                code={baselineCode}
                lang={recipe.baseline.lang}
                themes={shikiThemes}
                defaultColor="light"
                wrap
              />
            </figure>
          </div>
        </div>
      </section>
      )}

      {!recipe.baseline && (
      <section class="recipe-source">
        <h2>Source</h2>
        <p class="recipe-source__note">
          This recipe ships its source as a typed Effect-TS run — the
          recommended {recipe.mode}-mode shape.
        </p>
        {flareFiles.map(({ file, code }) => (
          <figure class="recipe-file">
            <figcaption>recipes/{recipe.slug}/{file.name}</figcaption>
            <Code
              code={code}
              lang={file.lang}
              themes={shikiThemes}
              defaultColor="light"
              wrap
            />
          </figure>
        ))}
      </section>
      )}

      <nav class="page-nav" aria-label="Adjacent recipes">
        {
          prev ? (
            <a href={`/recipes/${prev.slug}`} class="page-nav__prev">
              <span class="page-nav__direction">← Previous</span>
              <span class="page-nav__label">{prev.label}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={`/recipes/${next.slug}`} class="page-nav__next">
              <span class="page-nav__direction">Next →</span>
              <span class="page-nav__label">{next.label}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
  <MermaidRunner />

  <script>
    // Generic tab controller — drives both the top-level With/Without
    // FlareDispatch tabs and the nested per-file (yaml / ts) sub-tabs.
    // A tab carries `data-tab="<group>"` + `data-target="<panelId>"`; panels
    // carry `data-panel="<group>"`. Mirrors the controller on the homepage
    // snippets widget so the visual model is consistent.
    for (const tab of document.querySelectorAll<HTMLElement>("[data-tab]")) {
      tab.addEventListener("click", () => {
        const group = tab.getAttribute("data-tab");
        const target = tab.getAttribute("data-target");
        if (!group || !target) return;
        for (const t of document.querySelectorAll(`[data-tab="${group}"]`)) {
          t.setAttribute("aria-selected", String(t === tab));
        }
        for (const p of document.querySelectorAll<HTMLElement>(
          `[data-panel="${group}"]`,
        )) {
          p.toggleAttribute("hidden", p.id !== target);
        }
      });
    }
  </script>
</BaseLayout>
