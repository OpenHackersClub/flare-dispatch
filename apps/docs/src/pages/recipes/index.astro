---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recipes } from "../../lib/recipes";

const sections = [
  {
    number: "01",
    title: "Action mode",
    note: "Recommended trigger: a GitHub Actions workflow (ci.yml) that calls the shipped run via openhackersclub/flare-dispatch-action. The typed Effect-TS run is included alongside it.",
    items: recipes.filter((r) => r.mode === "Action"),
  },
  {
    number: "02",
    title: "Webhook mode",
    note: "Recommended trigger: the typed run's own triggers block — the FlareDispatch GitHub App webhook fires it directly, zero GHA minutes. An Action-mode ci.yml is included as the GHA-native alternative.",
    items: recipes.filter((r) => r.mode === "Webhook"),
  },
  {
    number: "03",
    title: "Schedule mode",
    note: "Recommended trigger: the typed run's own schedules block — a Cloudflare Cron Trigger fires it on a wall-clock cadence. No GitHub event, no GHA minutes, no workflow file; the cron expression also goes in wrangler.jsonc triggers.crons.",
    items: recipes.filter((r) => r.mode === "Schedule"),
  },
];
---

<BaseLayout
  title="Recipes — FlareDispatch"
  description="Worked examples of wiring real CI use cases onto FlareDispatch — browser tests, test matrices, CDP acceptance, security scans, deploy smoke, and AI code review."
>
  <div class="docs-index">
    <header class="docs-index__header">
      <div>
        <span class="section-marker">§ / Recipes</span>
        <h1>Worked examples.</h1>
      </div>
      <p>
        Each recipe is a copy-paste starting point for wiring a real CI use case
        onto FlareDispatch — adjust the inputs and drop it into your repo. Every
        recipe ships a typed Effect-TS run (<code>*.run.ts</code>); Action-mode
        recipes also ship a thin GitHub Actions dispatcher (<code>ci.yml</code>).
        Recipes are grouped below by their recommended trigger mode.
      </p>
      <p class="docs-index__compare-hint">
        Action- and Webhook-mode recipes also surface a <em>baseline</em> on
        their page — the full GitHub Actions workflow you'd have to maintain
        to do the same job <em>without</em> FlareDispatch — so the contrast
        is in plain sight.
      </p>
    </header>

    {
      sections.map((section) => (
        <section class="docs-index__section">
          <header class="docs-index__section-header">
            <span class="docs-index__section-num">§{section.number}</span>
            <h2 class="docs-index__section-title">{section.title}</h2>
          </header>
          <p class="docs-index__section-note">{section.note}</p>
          <div class="docs-index__grid">
            {section.items.map((recipe) => (
              <a class="docs-index__card" href={`/recipes/${recipe.slug}`}>
                <span class="docs-index__card-title">{recipe.label}</span>
                <p class="docs-index__card-blurb">{recipe.useCase}.</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
