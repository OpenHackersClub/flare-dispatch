---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recipes } from "../../lib/recipes";

// Grouped by what FIRES the run — NOT by a single "mode". A recipe is a run +
// a use case; the wiring (Webhook / Action / Schedule) is a dimension shown
// per card, recommended-first.
const sections = [
  {
    number: "01",
    title: "Event-driven",
    note: "Fires on a GitHub event (a PR push, a deploy). Wire it as Webhook (the App fires the run directly — no ci.yml) or Action (a ci.yml step), whichever fits; both post back as a Check Run. Webhook is shipped where the run's inputs come from the event itself.",
    items: recipes.filter((r) => r.triggerKind === "github-event"),
  },
  {
    number: "02",
    title: "Wall-clock",
    note: "Fires on a Cloudflare Cron Trigger — no GitHub event, no GHA minutes, no workflow file. The cron expression also goes in wrangler.jsonc triggers.crons; a GHA on: schedule step is the GHA-native alternative.",
    items: recipes.filter((r) => r.triggerKind === "wall-clock"),
  },
];
---

<BaseLayout
  title="Recipes — FlareDispatch"
  description="Worked examples of wiring real CI use cases onto FlareDispatch — browser tests, test matrices, CDP acceptance, security scans, deploy smoke, AI and multi-agent code review, and the Schedule-mode family (nightly e2e, release notes, scheduled deps audit, spec drift, CI triage)."
>
  <div class="docs-index">
    <header class="docs-index__header">
      <div>
        <span class="section-marker">§ / Recipes</span>
        <h1>Worked examples.</h1>
      </div>
      <p>
        Each recipe is a copy-paste starting point for wiring a real CI use case
        onto FlareDispatch — adjust the inputs and drop it into your repo. Every
        recipe is a typed Effect-TS run (<code>*.run.ts</code>); the wiring —
        <strong>Webhook</strong>, <strong>Action</strong>, or
        <strong>Schedule</strong> — is a dimension, not a category. The chips on
        each card show which wirings it supports, recommended first.
      </p>
      <p class="docs-index__compare-hint">
        Event-driven recipes also surface a <em>baseline</em> on their page —
        the full GitHub Actions workflow you'd have to maintain to do the same
        job <em>without</em> FlareDispatch — so the contrast is in plain sight.
      </p>
    </header>

    {
      sections.map((section) => (
        <section class="docs-index__section">
          <header class="docs-index__section-header">
            <span class="docs-index__section-num">§{section.number}</span>
            <h2 class="docs-index__section-title">{section.title}</h2>
          </header>
          <p class="docs-index__section-note">{section.note}</p>
          <div class="docs-index__grid">
            {section.items.map((recipe) => (
              <a class="docs-index__card" href={`/recipes/${recipe.slug}`}>
                <span class="docs-index__card-title">{recipe.label}</span>
                <p class="docs-index__card-blurb">{recipe.useCase}.</p>
                <span class="wiring-chips">
                  {recipe.wirings.map((w, i) => (
                    <span
                      class:list={[
                        "wiring-chip",
                        `wiring-chip--${w.status}`,
                        i === 0 && "wiring-chip--rec",
                      ]}
                      title={w.status === "shipped" ? "Shipped wiring" : "Setup pattern you add"}
                    >
                      {w.kind}
                      {w.status === "pattern" && <span class="wiring-chip__tag">pattern</span>}
                    </span>
                  ))}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
