# FlareDispatch demo-agent container image — published as
# `registry.cloudflare.com/openhackersclub/flare-dispatch-demo:latest`.
#
# The `product-demo` run shells out to a `demo-agent` CLI baked into this
# image (the "AI agent inside the image, not the runner" advantage in
# recipes/product-demo/README.md). That CLI:
#
#   * attaches to Cloudflare Browser Rendering over CDP (puppeteer-core),
#   * drives a deployed URL through prose-described user stories via a
#     Claude-driven computer-use loop,
#   * pulls the session's rrweb event stream via the Browser Rendering REST
#     recording endpoint,
#   * writes the holistic markdown summary the check-run embeds.
#
# Like `infra/Dockerfile.sandbox`, the runtime stage MUST inherit
# `docker.io/cloudflare/sandbox` so `@cloudflare/sandbox`'s Sandbox DO can
# RPC the in-container server — a bare Node base would have no sandbox
# server and every `sandbox.exec` call would fail.
#
# Two stages:
#   1. `builder`  — Node 22 + pnpm; install workspace deps, run esbuild on
#                   `packages/demo-agent` to produce a self-contained CJS
#                   bundle at `/build/dist/demo-agent.cjs`.
#   2. `runtime`  — the matching cloudflare/sandbox base, with the bundle
#                   copied to /usr/local/bin/demo-agent and made executable.
#                   Puppeteer-core only needs the WS endpoint (no bundled
#                   Chromium); the rest of the model loop is plain Node.
#
# Image tag pinning (when bumping the cloudflare/sandbox version):
#   * keep `Dockerfile.sandbox` + `Dockerfile.demo` on the SAME tag
#   * bump `@cloudflare/sandbox` in package.json to match

# ---------------------------------------------------------------------------
# Stage 1 — bundle demo-agent into a single CJS file.

FROM node:22-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate

WORKDIR /build

# Workspace manifests first so dep installs cache between source edits.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/demo-agent/package.json packages/demo-agent/tsconfig.json packages/demo-agent/vitest.config.ts ./packages/demo-agent/

# The workspace install only needs the demo-agent subgraph; the lockfile
# resolves the rest. Filtering via --filter keeps the layer small.
RUN pnpm install --frozen-lockfile --filter @flare-dispatch/demo-agent...

# Sources + bundle.
COPY packages/demo-agent/src ./packages/demo-agent/src
RUN pnpm --filter @flare-dispatch/demo-agent build

# ---------------------------------------------------------------------------
# Stage 2 — runtime: cloudflare/sandbox base + the bundled CLI.

FROM docker.io/cloudflare/sandbox:0.10.1 AS runtime

# Copy the bundle in as `demo-agent` on PATH. The bundle starts with a
# `#!/usr/bin/env node` shebang (esbuild --banner), so chmod +x is enough.
COPY --from=builder /build/packages/demo-agent/dist/demo-agent.cjs /usr/local/bin/demo-agent
RUN chmod +x /usr/local/bin/demo-agent

# Smoke-test the binary at image build time — surfaces a broken bundle
# before the image ships, not at first `sandbox.exec`.
RUN demo-agent --help > /dev/null
