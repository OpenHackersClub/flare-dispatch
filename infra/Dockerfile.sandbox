# FlareDispatch V0 Sandbox container image.
#
# The `@cloudflare/sandbox` SDK's `Sandbox` Durable Object speaks an HTTP/RPC
# protocol to a server process baked into the container — so the container
# image MUST be built from the matching `docker.io/cloudflare/sandbox` base,
# not a bare `node:lts-slim` (which has no sandbox server and would fail every
# `exec`). The base already ships Node + git + curl, so `offload-test`'s
# `git clone` / `pnpm test` run unmodified.
#
# The image tag is pinned to the SDK version in package.json
# (`@cloudflare/sandbox@0.10.1`) — bump both together.
#
# Cloudflare Containers pulls only from registry.cloudflare.com, docker.io, or
# Amazon ECR; docker.io is in scope (specs/05-byoc.md § Wrangler config).
#
# Spec: specs/pm/plan.md § 6 "Sandbox / Containers binding API".

FROM docker.io/cloudflare/sandbox:0.10.1

# Node 24 (LTS) alongside the base image's Node.
#
# The base image (cloudflare/sandbox:0.10.1) ships Node 22, which the
# `@cloudflare/sandbox` RPC server is compiled against. Modern monorepos that
# pin `engines.node: ">=24"` (and other consumers that need newer V8 / built-in
# globals) fail their `pnpm install` / `playwright test` when only Node 22 is on
# PATH inside `sandbox.exec`.
#
# Strategy: install Node 24 into `/opt/node24` as a tarball (binary-only, no
# package manager involvement) and prepend its `bin/` to PATH. The base image's
# bundled Node stays exactly where it was — the sandbox RPC server keeps using
# whichever Node it was built against — and user commands inside `sandbox.exec`
# resolve `node`/`npm`/`npx` to Node 24 first.
#
# Multi-arch: Cloudflare Containers runs on linux/amd64; we still detect arch
# at build time so the same Dockerfile works for local linux/arm64 development
# (e.g. on Apple Silicon).
ARG NODE24_VERSION=24.16.0
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64) node_arch=linux-x64 ;; \
        aarch64) node_arch=linux-arm64 ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE24_VERSION}/node-v${NODE24_VERSION}-${node_arch}.tar.gz" -o /tmp/node24.tar.gz; \
    mkdir -p /opt/node24; \
    tar -xzf /tmp/node24.tar.gz -C /opt/node24 --strip-components=1; \
    rm /tmp/node24.tar.gz; \
    /opt/node24/bin/node --version
ENV PATH=/opt/node24/bin:$PATH

# Enable Corepack so the `pnpm` / `yarn` shims are on PATH for every
# `sandbox.exec` / detached boot — without each command first running
# `corepack enable`. This matters because `installCached` (core primitive) runs
# the bare `pnpm install --frozen-lockfile`; on an image where pnpm isn't on
# PATH that exits 127 (`pnpm: not found`), and since the install exit code is
# not checked the failure is silent — leaving no node_modules and a boot chain
# that crashes ~2-3s later with PortNeverOpened. Corepack resolves the pinned
# version from each repo's `packageManager` field at first use.
RUN corepack enable

# Bake the Playwright headless browser into the image so Playwright runs (e.g.
# `playwright-demo`) don't download it on every `sandbox.exec`. A cold chromium
# download (~170MB) is the slowest, most failure-prone step of those runs: in
# the Sandbox it routinely exceeded the caller's install budget and got killed
# mid-fetch, leaving no browser and a test that fails instantly. Baking it once
# at build time takes that cost to ~0s at runtime.
#
# `chromium-headless-shell` (not full `chromium`) — it's ~3x smaller and is
# exactly the browser a headless run uses (a Playwright project with no pinned
# `channel` resolves to the bundled chromium → headless shell when running
# headless). The base image already carries chromium's shared libs (a headless
# run launches without `playwright install --with-deps`), so we skip the apt
# step entirely — which is also what made callers' runtime `--with-deps` hang
# the Sandbox indefinitely. Browsers land in a shared, image-baked path that
# every `sandbox.exec` sees via PLAYWRIGHT_BROWSERS_PATH, so callers DROP the
# `playwright install` step from their command.
#
# VERSION LOCKSTEP: Playwright pins each browser build to the library version.
# PLAYWRIGHT_VERSION MUST track the `@playwright/test` version consuming repos
# run. If a consumer floats ahead, Playwright re-downloads the matching build at
# runtime (graceful — just slower); bump this with consumers to keep it at ~0s.
ARG PLAYWRIGHT_VERSION=1.59.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN npx --yes playwright@${PLAYWRIGHT_VERSION} install chromium-headless-shell \
    && chmod -R a+rX /opt/pw-browsers
