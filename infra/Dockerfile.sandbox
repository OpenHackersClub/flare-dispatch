# FlareDispatch V0 Sandbox container image.
#
# The `@cloudflare/sandbox` SDK's `Sandbox` Durable Object speaks an HTTP/RPC
# protocol to a server process baked into the container — so the container
# image MUST be built from the matching `docker.io/cloudflare/sandbox` base,
# not a bare `node:lts-slim` (which has no sandbox server and would fail every
# `exec`). The base already ships Node + git + curl, so `offload-test`'s
# `git clone` / `pnpm test` run unmodified.
#
# The image tag is pinned to the SDK version in package.json
# (`@cloudflare/sandbox@0.10.1`) — bump both together.
#
# Cloudflare Containers pulls only from registry.cloudflare.com, docker.io, or
# Amazon ECR; docker.io is in scope (specs/05-byoc.md § Wrangler config).
#
# This ONE Dockerfile builds its image variants via build args (see the gated
# layers below + wrangler.jsonc § containers): `WITH_BROWSER` bakes a chromium
# variant (Issue #68), and `WITH_BUILD_TOOLS` bakes a native C/C++ toolchain
# (gcc/cc + make) so suites that compile native code in the sandbox — Rust
# `cargo`, node-gyp addons — can link. Both default off → a lean image.
#
# Spec: specs/pm/plan.md § 6 "Sandbox / Containers binding API".

# ── Stage 1 — bundle the demo-agent CLI ──────────────────────────────────────
#
# `product-demo` execs a bare `demo-agent` binary (no checkout, no install — it
# targets a deployed URL), so the binary MUST be on PATH in the sandbox image.
# This is the canonical integration the `recipes/product-demo/Dockerfile.example`
# documents, folded into the real image so product-demo works out-of-the-box for
# every consumer of this Dockerfile. `FD_REF` pins the flare-dispatch ref the
# agent bundle is built from (default `main`); bump alongside the SDK tag.
ARG FD_REF=main
FROM node:22-bookworm-slim AS demo-agent-builder
ARG FD_REF
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# Sparse + shallow clone — only the agent packages + their workspace deps are
# needed to bundle. `packages/bedrock-sigv4/` is a workspace dependency of
# demo-agent (since #153 extracted the SigV4 signer); omit it and esbuild fails
# to resolve `@flare-dispatch/bedrock-sigv4`. Keep this list in sync when an
# agent package gains a new in-repo dependency.
RUN git init . \
 && git remote add origin https://github.com/OpenHackersClub/flare-dispatch.git \
 && git fetch --depth=1 origin "${FD_REF}" \
 && git config core.sparseCheckout true \
 && printf 'package.json\npnpm-lock.yaml\npnpm-workspace.yaml\ntsconfig.base.json\npackages/demo-agent/\npackages/flare-agent/\npackages/bedrock-sigv4/\n' \
      > .git/info/sparse-checkout \
 && git checkout FETCH_HEAD
RUN pnpm install --frozen-lockfile --filter @flare-dispatch/demo-agent... --filter @flare-dispatch/flare-agent...
RUN pnpm --filter @flare-dispatch/demo-agent build
# flare-agent — the self-heal coding agent CLI. The 7 KB binary is present in
# ALL tiers (the COPY below is unconditional); only the agent tier (WITH_AGENT)
# actually invokes it via `sandboxImage: "agent"`. Built here unconditionally.
RUN pnpm --filter @flare-dispatch/flare-agent build

# ── Stage 2 — the runtime sandbox image ──────────────────────────────────────
FROM docker.io/cloudflare/sandbox:0.10.1

# Node 24 (LTS) alongside the base image's Node.
#
# The base image (cloudflare/sandbox:0.10.1) ships Node 22, which the
# `@cloudflare/sandbox` RPC server is compiled against. Modern monorepos that
# pin `engines.node: ">=24"` (and other consumers that need newer V8 / built-in
# globals) fail their `pnpm install` / `playwright test` when only Node 22 is on
# PATH inside `sandbox.exec`.
#
# Strategy: install Node 24 into `/opt/node24` as a tarball (binary-only, no
# package manager involvement) and prepend its `bin/` to PATH. The base image's
# bundled Node stays exactly where it was — the sandbox RPC server keeps using
# whichever Node it was built against — and user commands inside `sandbox.exec`
# resolve `node`/`npm`/`npx` to Node 24 first.
#
# Multi-arch: Cloudflare Containers runs on linux/amd64; we still detect arch
# at build time so the same Dockerfile works for local linux/arm64 development
# (e.g. on Apple Silicon).
ARG NODE24_VERSION=24.16.0
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64) node_arch=linux-x64 ;; \
        aarch64) node_arch=linux-arm64 ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE24_VERSION}/node-v${NODE24_VERSION}-${node_arch}.tar.gz" -o /tmp/node24.tar.gz; \
    mkdir -p /opt/node24; \
    tar -xzf /tmp/node24.tar.gz -C /opt/node24 --strip-components=1; \
    rm /tmp/node24.tar.gz; \
    /opt/node24/bin/node --version
ENV PATH=/opt/node24/bin:$PATH

# Enable Corepack so the `pnpm` / `yarn` shims are on PATH for every
# `sandbox.exec` / detached boot — without each command first running
# `corepack enable`. This matters because `installCached` (core primitive) runs
# the bare `pnpm install --frozen-lockfile`; on an image where pnpm isn't on
# PATH that exits 127 (`pnpm: not found`), and since the install exit code is
# not checked the failure is silent — leaving no node_modules and a boot chain
# that crashes ~2-3s later with PortNeverOpened. Corepack resolves the pinned
# version from each repo's `packageManager` field at first use.
RUN corepack enable

# demo-agent — install the bundle from stage 1 onto PATH and smoke-test it at
# build time so a broken bundle fails the image build, not the first
# `sandbox.exec("demo-agent", …)` in a product-demo run.
COPY --from=demo-agent-builder \
     /build/packages/demo-agent/dist/demo-agent.cjs \
     /usr/local/bin/demo-agent
RUN chmod +x /usr/local/bin/demo-agent \
 && demo-agent --help > /dev/null

# ── flare-agent (gated by WITH_AGENT — the self-heal agent tier) ──────────────
#
# The self-heal coding agent (specs/08-self-healing.md § 6.1). Runs declaring
# `sandboxImage: "agent"` (self-heal-pr) route to RunSandboxAgent, built with
# WITH_AGENT=true. The binary is copied unconditionally (7 KB; the build stage
# always produced it) but only the agent tier actually invokes it; the WITH_AGENT
# arg documents the tier and gates the build-time presence check. The MANDATORY
# egress allowlist (model-proxy + git remote only) is enforced at deploy via the
# account/Zero-Trust egress policy — there is no per-container wrangler field for
# it today, so it is a documented deploy prerequisite, NOT optional (§ 10.1).
ARG WITH_AGENT=false
COPY --from=demo-agent-builder \
     /build/packages/flare-agent/dist/flare-agent.cjs \
     /usr/local/bin/flare-agent
RUN chmod +x /usr/local/bin/flare-agent \
 && if [ "$WITH_AGENT" = "true" ]; then \
      test -x /usr/local/bin/flare-agent && echo "flare-agent baked (agent tier)."; \
    else \
      echo "WITH_AGENT=false — flare-agent present but tier inactive."; \
    fi

# ── Optional native build toolchain (gated by the WITH_BUILD_TOOLS build arg) ─
#
# The base image is deliberately lean: Node + git + curl, but NO C compiler.
# That's enough for pure-JS runs, but any `offload-test` suite that compiles
# native code in the sandbox needs a `cc`/linker — most commonly:
#
#   * Rust (`cargo test` / `cargo build`): rustc shells out to `cc` to link
#     every binary and to build `cc`-crate build scripts, so without it the run
#     dies at link with `error: linker 'cc' not found` — green on the author's
#     machine, red in the sandbox, deterministically.
#   * node-gyp native addons: `pnpm install` of any package with a binding.gyp
#     invokes make + g++.
#
# Gated exactly like WITH_BROWSER so the default image stays lean (most runs are
# pure JS): consumers that compile native code flip it on per container in
# wrangler.jsonc — `image_vars: { "WITH_BUILD_TOOLS": "true" }`. `build-essential`
# pulls gcc/g++/make/libc6-dev (the `cc` the linker needs); `pkg-config` is the
# tiny, near-universal gateway for `*-sys` crates. apt lists are removed in the
# same layer, so the disabled (default) path adds nothing and the enabled path
# stays as small as apt allows. A suite needing a specific system lib (e.g.
# `libssl-dev` for `openssl-sys`) appends it in its own run command.
ARG WITH_BUILD_TOOLS=false
RUN if [ "$WITH_BUILD_TOOLS" = "true" ]; then \
      set -eux; \
      export DEBIAN_FRONTEND=noninteractive; \
      apt-get update; \
      apt-get install -y --no-install-recommends build-essential pkg-config; \
      rm -rf /var/lib/apt/lists/*; \
      cc --version; \
    else \
      echo "WITH_BUILD_TOOLS=false — no native toolchain baked. Lean image."; \
    fi

# ── Optional Playwright browser layer (gated by the WITH_BROWSER build arg) ──
#
# This single Dockerfile produces BOTH sandbox images via Cloudflare's
# `image_vars` build args (wrangler.jsonc § containers):
#
#   * RunSandbox         → WITH_BROWSER unset/false → LEAN. The default for the
#                          ~majority of runs (`offload-test`, `pr-review`, plain
#                          `pnpm test`) and every `requiresBrowser: true` run
#                          (those dial CF Browser Rendering over CDP — they
#                          connect *out* to a CF-managed browser and need NO
#                          in-image chromium).
#   * RunSandboxBrowser  → WITH_BROWSER=true → bakes `chromium-headless-shell`.
#                          For runs that launch Playwright's own chromium INSIDE
#                          the sandbox (`playwright-demo`, via `sandboxImage:
#                          "browser"`). Note this axis is DISTINCT from
#                          `limits.requiresBrowser` — see the routing note in
#                          apps/dispatcher/src/workflow.ts.
#
# Sharing one Dockerfile keeps the Node 24 + Corepack preamble single-sourced;
# only the final browser layer differs. Issue #68 tracks whether the split is
# worth keeping (gated on a cold-start measurement).
#
# Why `chromium-headless-shell` (not full `chromium`): it's ~3x smaller and is
# exactly the browser a headless run uses (a Playwright project with no pinned
# `channel` resolves to the bundled chromium → headless shell when headless).
# The base image already carries chromium's shared libs (a headless run launches
# without `playwright install --with-deps`), so we skip the apt step entirely —
# which is also what made callers' runtime `--with-deps` hang the Sandbox
# indefinitely. Browsers land in a shared, image-baked path that every
# `sandbox.exec` sees via PLAYWRIGHT_BROWSERS_PATH, so callers DROP the
# `playwright install` step from their command.
#
# A cold chromium download (~170MB) is the slowest, most failure-prone step of a
# Playwright run: in the Sandbox it routinely exceeded the caller's install
# budget and got killed mid-fetch, leaving no browser and a test that failed
# instantly. Baking it takes that cost to ~0s at runtime.
#
# VERSION LOCKSTEP: Playwright pins each browser build to the library version.
# PLAYWRIGHT_VERSION MUST track the `@playwright/test` version consuming repos
# run. If a consumer floats ahead, Playwright re-downloads the matching build at
# runtime (graceful — just slower); bump this with consumers to keep it at ~0s.
ARG WITH_BROWSER=false
ARG PLAYWRIGHT_VERSION=1.59.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
# The chromium bake is intentionally DISABLED. It was added (#66) so a
# `sandboxImage: "browser"` run got chromium at ~0s, but since #75 moved
# `playwright-demo` onto the lean image NO run declares `sandboxImage: "browser"`
# — the bake is dead weight. Worse, building it hung every `wrangler deploy`:
# after the ~112MB `chromium-headless-shell` download the layer build/registry
# push stalled indefinitely (killed at GitHub's 6h job cap; reproduces locally),
# which blocked the serialized deploy queue for hours and kept merged fixes from
# ever reaching the Dispatcher. Skipping it makes both images lean — the
# `WITH_BROWSER` arg + `RUNS_SANDBOX_BROWSER` binding stay (no DO migration), so
# the routing axis is preserved; a future in-sandbox-chromium run just downloads
# the browser at runtime (the pre-#66 behaviour) instead of getting it baked.
RUN echo "WITH_BROWSER=$WITH_BROWSER — chromium bake disabled (unused since #75; hung the deploy). Lean image."
