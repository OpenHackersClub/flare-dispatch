{
  "name": "flare-dispatch",
  "version": "0.0.0",
  "private": true,
  "description": "Offload CI and agentic workflows from GitHub Actions to Cloudflare.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./apps/dispatcher\" --filter \"./runs\" exec tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "cli": "pnpm --filter @flare-dispatch/cli cli"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250510.0",
    "effect": "^3.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.50.0"
  }
}
