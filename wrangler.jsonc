{
  // FlareDispatch Dispatcher Worker.
  // Bindings: Workflow, R2, D1, Container, KV (config). No Queue (deferred to
  // V1 matrix fan-out); Browser Rendering lands in V2 (PR9).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-dispatch-v0",
  "main": "apps/dispatcher/src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Plain (non-secret) vars.
  //   CLOUDFLARE_ACCOUNT_ID — the 32-hex account id from the dashboard URL.
  //     When set, RunWorkflow adds a `details_url` to the GitHub check-run
  //     linking to the Cloudflare Workflows instance page
  //     (dash.cloudflare.com/<id>/workers/workflows/runs-workflow/instance/<executionId>),
  //     so reviewers jump from the PR check straight to the execution's step
  //     logs. Omit it (the BYOC default — each deploy owns its account) and the
  //     check-run renders exactly as before with no link. Uncomment + fill, or
  //     override per-deploy with `CLOUDFLARE_ACCOUNT_ID=... wrangler deploy`.
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "c91d52c288c452ab734ede1518b00e11"
  },

  // RunWorkflow (apps/dispatcher/src/workflow.ts) maps each run `step(...)` to a
  // durable WorkflowStep.do checkpoint under an Effect runtime — see PR4.
  "workflows": [
    {
      "name": "runs-workflow",
      "binding": "RUNS_WORKFLOW",
      "class_name": "RunWorkflow"
    }
  ],

  // Container binding. The `@cloudflare/sandbox` SDK's Sandbox DO speaks an
  // RPC protocol to a server baked into the container, so the image is built
  // from the matching `docker.io/cloudflare/sandbox` base via a Dockerfile
  // (infra/Dockerfile.sandbox) — a bare node image has no sandbox server.
  // Cloudflare Containers pulls only from registry.cloudflare.com, docker.io,
  // or Amazon ECR; the Dockerfile's FROM resolves docker.io.
  "containers": [
    {
      "class_name": "RunSandbox",
      "image": "./infra/Dockerfile.sandbox",
      "instance_type": "standard-2",
      "max_instances": 16
    }
  ],

  // The Container runtime is fronted by a Durable Object class — wrangler
  // requires the class to be registered via a migration. RunSandbox is the
  // DO class backing the RUNS_SANDBOX container binding (not the Coordinator
  // fan-out DO, which is deferred to V1).
  "durable_objects": {
    "bindings": [
      { "name": "RUNS_SANDBOX", "class_name": "RunSandbox" }
    ]
  },

  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["RunSandbox"] }
  ],

  "r2_buckets": [
    { "binding": "RUNS_STORAGE", "bucket_name": "flare-dispatch-v0" }
  ],

  "d1_databases": [
    {
      "binding": "RUNS_METADATA",
      "database_name": "flare-dispatch-v0",
      "database_id": "9bebd4f1-8036-4461-9031-efb880d6259f"
    }
  ],

  // KV namespaces.
  //   * CONFIG_KV         — `config` capability + the `loadSecrets` store.
  //   * IDEMPOTENCY_KV    — receiver-level dedup (spec 04-gha § Receiver
  //                         dedup). Optional: absent → dedup falls back to CF
  //                         Workflows' platform-level `create({id})` no-op.
  //   * INSTALL_TOKEN_KV  — GitHub App installation-token cache. Optional:
  //                         absent → token cached in Worker memory only.
  // Provision each with `wrangler kv namespace create <BINDING>` and paste
  // the id back in.
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "efc3ec8fd0d040e689d43276e0946c7f"
    },
    // IDEMPOTENCY_KV — optional (env.ts marks it `?`; dispatch.ts/webhook.ts
    // guard every use with `!== undefined`). Absent → receiver dedup falls
    // back to CF Workflows' platform-level `create({id})` no-op. Left
    // unbound: a placeholder all-zeros id fails `wrangler deploy` with KV
    // 10041. Run `wrangler kv namespace create IDEMPOTENCY_KV` and uncomment
    // with the real id to enable receiver-level dedup.
    // {
    //   "binding": "IDEMPOTENCY_KV",
    //   "id": "00000000000000000000000000000000"
    // },
    // INSTALL_TOKEN_KV — deferred to V1; the check-runs Layer caches
    // installation tokens in Worker memory only (the V0 behaviour).
    // Uncomment and fill the real id when wiring the KV cache.
    // {
    //   "binding": "INSTALL_TOKEN_KV",
    //   "id": "00000000000000000000000000000000"
    // }
  ],

  // Worker Secrets used by V0-V3 runtime (set with `wrangler secret put`):
  //   HMAC_SECRET                — Action-mode dispatch HMAC
  //   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY  — check-runs callback auth
  //   GITHUB_WEBHOOK_SECRET      — POST /v1/webhooks/github verify
  //   ADMIN_TOKEN                — POST /v1/admin/events/:wf_id bearer
  //   BROWSER_CDP_CONNECT_URL,
  //   BROWSER_CDP_API_TOKEN      — V2 Browser Rendering connect
  //   OIDC_SIGNING_JWK,
  //   OIDC_ISSUER_URL            — V3.5 OIDC issuer (AWS STS federation)
  // None of these are declared here — Worker Secrets are out-of-band by design.

  // Cron Triggers — the wall-clock heartbeat Schedule-mode runs subscribe to.
  // Each entry MUST also appear in some run's `schedules[].cron` in `runs/`;
  // the `scheduled()` handler in `apps/dispatcher/src/index.ts` routes the
  // firing `controller.cron` to whichever runs match (registry helper
  // `schedulesByCron`). See specs/04-gha-integration.md § Schedule mode.
  //
  //   "0 14 * * *"  — 14:00 UTC daily, the `product-demo` stakeholder demo
  //                   (runs/product-demo.ts). Attaches Browser Run over CDP
  //                   with native rrweb session recording, drives the agent
  //                   through the operator's story list, uploads replay.json
  //                   (rrweb events) + key screenshots + summary.md as
  //                   signed R2 artifacts.
  "triggers": {
    "crons": [
      "0 14 * * *"
    ]
  }
}
