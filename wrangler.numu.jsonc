{
  // numu-ai deploy config for the FlareDispatch Dispatcher (flare-dispatch-v0).
  // Mirrors ./wrangler.jsonc but with the numu-ai account's resource ids only
  // — NO upstream/OHC ids. Used as `wrangler deploy -c wrangler.numu.jsonc`.
  // Not committed (numu-specific operator config).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-dispatch-v0",
  "account_id": "5c9c9e6f153b3aa62c715a6d4af3c9ef",
  "main": "apps/dispatcher/src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // exposePort preview-URL host. Requires a wildcard-routed custom domain
  // (workers.dev can't route <port>-<id>.<host>): *.fd-sandbox.numu.gg → this
  // worker, with a proxied wildcard DNS record in the numu.gg zone.
  "vars": {
    "SANDBOX_PREVIEW_HOSTNAME": "fd-sandbox.numu.gg",
    "CLOUDFLARE_ACCOUNT_ID": "5c9c9e6f153b3aa62c715a6d4af3c9ef",
    // EMAIL_FROM — verified Email Routing sender for the completion-notify
    // email. numu.gg has Email Routing enabled (status: unlocked).
    "EMAIL_FROM": "flare-dispatch@numu.gg",
    "EMAIL_FROM_NAME": "FlareDispatch",
    // Allowlist guard — a dispatch's notify.emails recipient not on this list
    // is rejected before the provider call, on top of Cloudflare's own
    // verified-destination enforcement. The two demo recipients.
    "EMAIL_ALLOWED_RECIPIENTS": "jarvis@fractalbox.dev,numu@fractalbox.dev",
    // AI Gateway the `modelGateway` routes Workers AI calls through (caching /
    // rate-limiting / observability). The `pr-review` engine's model backend.
    "AI_GATEWAY_ID": "numu-staging"
  },

  // Workers AI binding — backs the `modelGateway` capability the `pr-review`
  // engine calls. The binding is the auth (account-billed); no model API key.
  // Routed through the `AI_GATEWAY_ID` gateway above.
  "ai": { "binding": "AI" },

  // Email Routing `send_email` binding — backs the `email` capability + the
  // Workflow's completion-notify. Delivers only to verified Email Routing
  // destination addresses on the numu.gg zone.
  "send_email": [
    { "name": "SEND_EMAIL" }
  ],

  // Browser Rendering binding — backs `GET /v1/browser/cdp`, the CDP proxy the
  // cdp-acceptance container connects to. CF Browser Rendering CDP is only
  // reachable via this binding, not a public token-dialable WebSocket.
  "browser": { "binding": "BROWSER" },

  "workflows": [
    {
      "name": "runs-workflow",
      "binding": "RUNS_WORKFLOW",
      "class_name": "RunWorkflow"
    }
  ],

  // Two images from one Dockerfile (lean + chromium-baked) via WITH_BROWSER —
  // mirrors wrangler.jsonc. Routing is per-run on `sandboxImage` (workflow.ts).
  "containers": [
    {
      "class_name": "RunSandbox",
      "image": "./infra/Dockerfile.sandbox",
      "instance_type": "standard-2",
      "max_instances": 16
    },
    {
      "class_name": "RunSandboxBrowser",
      "image": "./infra/Dockerfile.sandbox",
      "image_vars": { "WITH_BROWSER": "true" },
      "instance_type": "standard-2",
      "max_instances": 16
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RUNS_SANDBOX", "class_name": "RunSandbox" },
      { "name": "RUNS_SANDBOX_BROWSER", "class_name": "RunSandboxBrowser" }
    ]
  },

  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["RunSandbox"] },
    { "tag": "v1", "new_sqlite_classes": ["RunSandboxBrowser"] }
  ],

  "r2_buckets": [
    { "binding": "RUNS_STORAGE", "bucket_name": "flare-dispatch-v0" }
  ],

  "d1_databases": [
    {
      "binding": "RUNS_METADATA",
      "database_name": "flare-dispatch-v0",
      "database_id": "2bc1dbca-ee48-47e3-82c9-7d65dbeecbcd"
    }
  ],

  // Only CONFIG_KV — the live numu-ai worker has no IDEMPOTENCY_KV /
  // INSTALL_TOKEN_KV bindings (both optional), so they're omitted here.
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "e6f5012673314866a7d629f9ecd93c0c"
    }
  ],

  "triggers": {
    "crons": ["0 14 * * *"]
  }
}
